<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Asp.Versioning ships analyzers that ask for Asp.Versioning.OpenApi's AddOpenApi()
         and MapOpenApi().WithDocumentPerVersion(). That package has no asset below the
         newest framework, so depending on it would mean a second code path here. Program.cs
         registers the per-version document directly instead - the same result the rules are
         asking for, reached without the dependency, and proven by the functional tests that
         fetch /openapi/v1.json. Remove these if you add Asp.Versioning.OpenApi yourself. -->
    <NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>BaseRepository.Api</RootNamespace>
    <AssemblyName>BaseRepository.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\BaseRepository.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\BaseRepository.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

</Project>
