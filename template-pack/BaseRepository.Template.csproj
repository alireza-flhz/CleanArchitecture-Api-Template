<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>BaseRepository.Template</PackageId>
    <Title>Clean Architecture API Template</Title>
    <Authors>alireza-flhz</Authors>
    <Description>dotnet new template for a fully generic Clean Architecture .NET API: layered projects, a custom zero-dependency CQRS mediator, EF Core persistence, built-in register/login with self-service profile (JWT auth, international phone validation via libphonenumber), API versioning, output caching, and a working TodoItem sample wired end to end.</Description>
    <PackageVersion>1.0.0-preview.2</PackageVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/alireza-flhz/CleanArchitecture-Api-Template</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alireza-flhz/CleanArchitecture-Api-Template</RepositoryUrl>
    <PackageTags>dotnet-new;templates;clean-architecture;cqrs;webapi;api;auth;jwt</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed to the package root (not content/) so nuget.org renders it as the package
         description page. The copy under content/ is the one a scaffolded project gets. -->
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../**/*" Exclude="../**/bin/**;../**/obj/**;../**/*.db;../**/*.db-shm;../**/*.db-wal;../.git/**;../template-pack/**;../*.nupkg">
      <Pack>true</Pack>
      <PackagePath>content</PackagePath>
    </Content>
  </ItemGroup>

</Project>
